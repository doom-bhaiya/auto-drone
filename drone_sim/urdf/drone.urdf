<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0.7854"/>
      <geometry>
        <mesh filename="package://drone_sim/meshes/drone.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Gray">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="0 0 0.7854"/>
      <geometry>
        <mesh filename="package://drone_sim/meshes/drone.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0.7854"/>
      <mass value="1.2"/>
      <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1"/>
    </inertial>
  </link>

  <xacro:macro name="motor" params="name x y">
    <link name="${name}">
      <inertial>
        <origin rpy="0 0 0"/>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>

      <visual>
        <origin rpy="1.57 0 0" xyz="0 0 0.01"/>
        <geometry>
           <mesh filename="package://drone_sim/meshes/motor.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="Red">
          <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>  

    <xacro:macro name="propeller" params="name motor">
    <link name="${name}">
      <inertial>
        <origin rpy="0 0 0"/>
        <mass value="0.000001"/>
        <inertia ixx="0.00000001" ixy="0.0" ixz="0.0" iyy="0.00000001" iyz="0.0" izz="0.00000001"/>
      </inertial>

      <visual>
        <origin rpy="1.57 0 0" xyz="0 0 0.0208"/>
        <geometry>
           <mesh filename="package://drone_sim/meshes/prop.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="Black">
          <color rgba="0.8 0.8 0.8 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${motor}"/>
      <child link="${name}"/>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>  

  <xacro:motor name="motor1" x="0.13181" y="0"/>
  <xacro:motor name="motor2" x="0" y="0.13181"/> 
  <xacro:motor name="motor3" x="-0.13181" y="0"/>
  <xacro:motor name="motor4" x="0" y="-0.13181"/> 

  <xacro:propeller name="prop1" motor="motor1"/>
  <xacro:propeller name="prop2" motor="motor2"/> 
  <xacro:propeller name="prop3" motor="motor3"/>
  <xacro:propeller name="prop4" motor="motor4"/> 

  <xacro:include filename="$(find drone_sim)/urdf/gazebo.urdf"/>

</robot>
