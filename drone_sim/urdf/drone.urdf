<?xml version="1.0"?>
<robot name="my_robot">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0.7854"/>
      <geometry>
        <mesh filename="package://drone_sim/meshes/drone.dae" scale="0.001 0.001 0.001"/>
        package://urdf_tutorial/meshes/l_finger.dae
      </geometry>
      <!-- <material name="Cyan">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material> -->
    </visual>

    <collision>
      <origin rpy="0 0 0.7854"/>
      <geometry>
        <mesh filename="package://drone_sim/meshes/drone.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0.7854"/>
      <mass value="1.2"/>
      <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1"/>
    </inertial>
  </link>


  <link name="prop1">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>

    <collision>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
    </collision>

    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="Cyan">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>


  <link name="prop2">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>

    <collision>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
    </collision>

    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="Cyan">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <link name="prop3">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>

    <collision>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
    </collision>

    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="Cyan">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <link name="prop4">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>

    <collision>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
    </collision>

    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="Cyan">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>


  <joint name="prop1_joint" type="revolute">
    <parent link="base_link"/>
    <child link="prop1"/>
    <origin xyz="0 -0.13181 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="100"/>
  </joint>


  <joint name="prop2_joint" type="revolute">
    <parent link="base_link"/>
    <child link="prop2"/>
    <origin xyz="0.13181 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="100"/>
  </joint>


  <joint name="prop3_joint" type="revolute">
    <parent link="base_link"/>
    <child link="prop3"/>
    <origin xyz="-0 0.13181 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="100"/>
  </joint>


  <joint name="prop4_joint" type="revolute">
    <parent link="base_link"/>
    <child link="prop4"/>
    <origin xyz="-0.13181 0. 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="100"/>
  </joint>

  <!-- Gazebo plugin -->
  <gazebo>
    <plugin name="drone_plugin" filename="libdrone_plugin.so"/>
  </gazebo>

  <!-- <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/diff_bot</namespace>
      </ros>
      <left_joint>prop3_joint</left_joint>
      <right_joint>prop4_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_diameter>0.15</wheel_diameter>
      <topic>cmd_vel</topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo> -->

</robot>
