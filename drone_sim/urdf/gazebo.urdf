<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin filename="libDronePlugin.so"
     name="gz::sim::systems::DronePlugin">

      <base_link_name>base_link</base_link_name>
      <prop_link_name1>prop1</prop_link_name1>
      <prop_link_name2>prop2</prop_link_name2>
      <prop_link_name3>prop3</prop_link_name3>
      <prop_link_name4>prop4</prop_link_name4>

      <prop1_joint>prop1_joint</prop1_joint>
      <prop2_joint>prop2_joint</prop2_joint>
      <prop3_joint>prop3_joint</prop3_joint>
      <prop4_joint>prop4_joint</prop4_joint>

      <cmd_vel>cmd_vel</cmd_vel>
      <enable_topic>switchOn</enable_topic>
      <odom_topic>DronePose</odom_topic>

      <max_velocity>2500</max_velocity>
      <max_acceleration>1000</max_acceleration>
      <noise_std_dev>60</noise_std_dev>

      <config_file_path>$(find drone_sim)/config/drone_params.json</config_file_path>

    </plugin>
  </gazebo>

</robot>